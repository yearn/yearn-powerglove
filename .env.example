VITE_PUBLIC_GRAPHQL_URL=https://kong.yearn.fi/api/gql
VITE_PUBLIC_REST_URL=https://kong.yearn.fi/api/rest
VITE_PUBLIC_YDAEMON_URL=https://ydaemon.yearn.fi/
VITE_PUBLIC_YVUSD_APR_API_URL=/api/yvusd/aprs
YVUSD_APR_SERVICE_API=https://yvusd-api.yearn.fi/api/aprs

# Local-only preview hosts, comma-separated. Put personal Tailscale hosts in .env, not in git.
LOCAL_VITE_ALLOWED_HOSTS=

VITE_PUBLIC_REALLOCATION_API_URL=

VITE_PUBLIC_ENVIO_GRAPHQL_URL=

# Stats APIs. Leave public URLs empty for local Vite proxying.
VITE_PUBLIC_YEARN_TVL_API_URL=
VITE_PUBLIC_YEARN_FEES_API_URL=
# Optional local proxy targets (defaults: TVL 3460, canonical fees 3482).
VITE_YEARN_TVL_API_TARGET=
VITE_YEARN_FEES_API_TARGET=

# Backward-compatible fallback while migrating away from yearn-metrics.
VITE_PUBLIC_YEARN_METRICS_API_URL=

VITE_RPC_URI_FOR_1= # optional
VITE_RPC_URI_FOR_10= # optional
VITE_RPC_URI_FOR_100= # optional
VITE_RPC_URI_FOR_137= # optional
VITE_RPC_URI_FOR_250= # optional
VITE_RPC_URI_FOR_8453= # optional
VITE_RPC_URI_FOR_42161= # optional
VITE_RPC_URI_FOR_747474= # optional
VITE_RPC_URI_FOR_80094= # optional
